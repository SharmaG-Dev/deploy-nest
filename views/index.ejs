    <script>
        // Check if user is logged in
        document.addEventListener('DOMContentLoaded', () => {
            const token = localStorage.getItem('accessToken');
            if (token) {
                const navBtn = document.getElementById('nav-action-btn');
                const heroBtn = document.getElementById('hero-action-btn');
                
                navBtn.textContent = 'Dashboard';
                navBtn.href = '/dashboard';
                navBtn.className = "px-5 py-2 text-sm font-semibold rounded-lg bg-brand-500/20 text-brand-300 hover:bg-brand-500/30 border border-brand-500/30 transition-all duration-300";
                
                heroBtn.innerHTML = 'Go to Dashboard <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>';
                heroBtn.href = '/dashboard';
            }

            // Simple navbar background on scroll
            window.addEventListener('scroll', () => {
                const nav = document.getElementById('navbar');
                if (window.scrollY > 20) {
                    nav.classList.add('shadow-lg', 'bg-surface-950/80');
                    nav.classList.remove('border-transparent');
                } else {
                    nav.classList.remove('shadow-lg', 'bg-surface-950/80');
